# Copy to .env and fill in. Never commit .env.

# SEC EDGAR requires a descriptive User-Agent with contact info
SEC_USER_AGENT="sec-agent research your-email@example.com"

# LLM providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Eval judge (make eval)
GEMINI_API_KEY=
# Answer model, key from build.nvidia.com
NVIDIA_API_KEY=

# Vector stores
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and adds ~2 s per request
QDRANT_URL=http://127.0.0.1:6333
PINECONE_API_KEY=

# Tracing: Langfuse Cloud (free Hobby plan), keys from the project's settings page.
# Leave the keys empty to turn tracing off.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Grafana admin login (user: admin), dashboard on 127.0.0.1:3000
GRAFANA_ADMIN_PASSWORD=

# Gateway: comma-separated client keys, each at least 32 characters (e.g. python -c "import secrets;print('sk-local-'+secrets.token_urlsafe(24))")
GATEWAY_API_KEYS=
# Requests per minute per key
RATE_LIMIT_PER_MINUTE=10

# Answer LLM: any OpenAI-compatible endpoint.
# NVIDIA hosted (default): https://integrate.api.nvidia.com/v1, key from build.nvidia.com
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=qwen3.5:4b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=${NVIDIA_API_KEY}
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
