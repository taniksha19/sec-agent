update t# Copy to .env and fill in. Never commit .env.

# SEC EDGAR requires a descriptive User-Agent with contact info
SEC_USER_AGENT="sec-agent research your-email@example.com"

# LLM providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Eval judge (make eval)
GEMINI_API_KEY=
# Answer model, key from build.nvidia.com
NVIDIA_API_KEY=

# Vector stores
QDRANT_URL=http://localhost:6333
PINECONE_API_KEY=

# Observability (self-hosted Langfuse)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Gateway
GATEWAY_API_KEYS=

# Answer LLM: any OpenAI-compatible endpoint.
# NVIDIA hosted (default): https://integrate.api.nvidia.com/v1, key from build.nvidia.com
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=qwen3.5:4b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=${NVIDIA_API_KEY}
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
